generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id              String         @id @default(cuid())
  name            String?
  email           String?        @unique
  emailVerified   DateTime?
  image           String?
  role            Role           @default(USER)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  password        String?
  bio             String?
  preferredTopics String[]
  dailyBriefing   Boolean      @default(false)
  accounts        Account[]
  articles        Article[]
  sessions        Session[]
  savedArticles   SavedArticle[]
  comments        Comment[]
  reactions       ArticleReaction[]
  priceAlerts     PriceAlert[]
  priceReports    PriceReport[]
  following       Follow[]     @relation("Following")
  followers       Follow[]     @relation("Followers")
  announcementComments AnnouncementComment[]
  mobileBookmarks MobileBookmark[]
  mobileReactions MobileReaction[]
  mobileFollows   MobileFollow[]
  mobileDevices   MobileDevice[]
}

model SavedArticle {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
}

/// Daily retention aggregates. One row per UTC day, counters only — no session,
/// device or reader identifier, because the client decides "first visit or
/// return?" locally and reports just the boolean.
model RetentionDay {
  id              String   @id @default(cuid())
  day             DateTime @unique @db.Date
  firstVisits     Int      @default(0)
  returningVisits Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Article {
  id            String         @id @default(cuid())
  title         String
  content       String
  summary       String?
  imageUrl      String?
  /// Canonical link of the story this row mirrors, when it has one.
  ///
  /// Scraped articles record the outlet's URL here so the importer can match on
  /// the story's identity instead of its headline, and so a bookmark saved in
  /// the mobile app (`MobileBookmark.sourceUrl`) can be reconciled with the
  /// article stored by the web app. Nullable: rows that predate the column and
  /// drafts written in the editor have no external URL. Unique: two rows for the
  /// same link are exactly the duplicate this column exists to prevent (Postgres
  /// permits many NULLs in a unique index).
  sourceUrl     String?        @unique
  published     Boolean        @default(false)
  status        Status         @default(DRAFT)
  province      String?
  district      String?
  authorId      String
  breaking      Boolean        @default(false)
  breakingSetAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  publishedAt   DateTime?
  author        User           @relation(fields: [authorId], references: [id])
  categories    Category[]     @relation("ArticleToCategory")
  savedByUsers  SavedArticle[]
  comments      Comment[]
  reactions     ArticleReaction[]

  @@index([published, status])
  @@index([published, status, publishedAt])
  @@index([breaking, published, status])
  @@index([publishedAt])
  @@index([updatedAt])
  @@index([province])
  @@index([authorId])
  @@index([title])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  articles Article[] @relation("ArticleToCategory")
}

enum Role {
  USER
  WRITER
  EDITOR
  ADMIN
}

enum Status {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
}

model MarketPrice {
  id          String   @id @default(cuid())
  commodity   String
  market      String   @default("Freetown Central")
  price       Float
  trend       String?
  trendPct    Float?
  trendPeriod String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([commodity, market])
}

model Announcement {
  id           String   @id @default(cuid())
  title        String
  body         String
  category     String
  icon         String
  organization String
  location     String
  dateLabel    String
  urgency      String?
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  comments     AnnouncementComment[]

  @@index([published, category, createdAt])
}

model AnnouncementComment {
  id             String       @id @default(cuid())
  content        String
  announcementId String
  userId         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([announcementId, createdAt])
  @@index([userId])
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  articleId String
  userId    String
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  article Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@index([articleId, createdAt])
  @@index([userId])
}

model ArticleReaction {
  id        String   @id @default(cuid())
  articleId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId, emoji])
  @@index([articleId])
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  @@index([email])
  @@index([token])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  keys      Json
  userId    String?
  createdAt DateTime @default(now())
}

model PriceAlert {
  id             String    @id @default(cuid())
  userId         String
  commodity      String
  market         String
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, commodity, market])
  @@index([market])
}

model PriceReport {
  id            String   @id @default(cuid())
  userId        String
  commodity     String
  market        String
  reportedPrice Float
  notes         String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

/// Mobile reader state, synced from the Flutter app (`docs/SYNC-API.md` in
/// SLNews-Mobile owns the contract).
///
/// These are deliberately separate from SavedArticle/ArticleReaction: mobile
/// items are external ids (`slnews-api:4821`, `rss:<hash>`) with no PWA Article
/// row, so the row snapshots the handful of display fields needed to render a
/// saved list offline. `updatedAt` is the CLIENT's clock (last-write-wins), so it
/// is not `@updatedAt`; `deletedAt` is a tombstone rather than a hard delete so a
/// stale device cannot resurrect a removal.
model MobileBookmark {
  id          String    @id @default(cuid())
  userId      String
  itemId      String
  title       String
  sourceUrl   String?
  imageUrl    String?
  publisher   String?
  publishedAt DateTime?
  savedAt     DateTime
  updatedAt   DateTime
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId, updatedAt])
}

/// A reader's like on a story; `kind` leaves room for further reactions.
model MobileReaction {
  id        String    @id @default(cuid())
  userId    String
  itemId    String
  kind      String    @default("like")
  updatedAt DateTime
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId, kind])
  @@index([userId, updatedAt])
}

/// A followed team, league, location, topic or publisher (`team:lal`).
model MobileFollow {
  id        String    @id @default(cuid())
  userId    String
  targetId  String
  kind      String
  label     String?
  updatedAt DateTime
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetId])
  @@index([userId, updatedAt])
}

/// A native app installation that can receive push notifications.
///
/// The web app registers browser endpoints in `PushSubscription` (VAPID), which
/// only browsers can receive. A phone needs an FCM token instead, so it registers
/// here after sign-in and the token is used by `src/lib/push/fcm.ts`.
///
/// `token` is unique because FCM reissues the same token for a reinstalled app on
/// the same device: the registration is an upsert keyed by the token, so a reader
/// with two devices gets two rows and a re-registration never duplicates one.
model MobileDevice {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  /// "android" | "ios"; kept as text so a new platform needs no migration.
  platform   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  /// Last time the app re-registered (cheap liveness signal for pruning).
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
